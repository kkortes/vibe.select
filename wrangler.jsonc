{
  "name": "vibe-select",
  "main": "./server/worker.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./compiled",
    "binding": "ASSETS",
    "run_worker_first": ["/js/pin.js"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibe-select",
      "database_id": "40d1438e-30ab-4859-ac34-f95ff994e08c",
      "migrations_dir": "./server/migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "615897294940-j7pp91r1bdn8j3v9l5k7rifrrhgodt5i.apps.googleusercontent.com"
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "vibe-select-preview",
        "database_id": "e85d0d26-103a-4409-87b3-7681cfe6e4ff",
        "migrations_dir": "./server/migrations"
      }
    ],
    "vars": {
      "GOOGLE_CLIENT_ID": "615897294940-j7pp91r1bdn8j3v9l5k7rifrrhgodt5i.apps.googleusercontent.com",
      "PREVIEW_SIGNIN": "me@korte.kim"
    }
  }
}
